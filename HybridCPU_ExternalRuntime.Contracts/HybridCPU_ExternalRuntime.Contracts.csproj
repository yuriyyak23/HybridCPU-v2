<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>HybridCPU_ExternalRuntime.Contracts</AssemblyName>
    <PackageId>HybridCPU.ExternalRuntime.Contracts</PackageId>
    <Version>1.3.0</Version>
    <PackageVersion>1.3.0</PackageVersion>
    <Authors>HybridCPU</Authors>
    <Description>Stable semantic contracts for the HybridCPU external runtime facade.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="PublicApi.Shipped.txt" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
