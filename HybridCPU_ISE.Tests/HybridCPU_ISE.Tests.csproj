<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<DefineTestSupport Condition="'$(Configuration)' != 'Release'">true</DefineTestSupport>
		<HybridCpuIseProjectReferenceProperties Condition="'$(HybridCpuTestArtifactsRoot)' == ''">DefineTestSupport=$(DefineTestSupport);BaseIntermediateOutputPath=obj\testsupport\;MSBuildProjectExtensionsPath=obj\;OutputPath=bin\$(Configuration)\testsupport\</HybridCpuIseProjectReferenceProperties>
		<HybridCpuIseProjectReferenceProperties Condition="'$(HybridCpuTestArtifactsRoot)' != ''">DefineTestSupport=$(DefineTestSupport);HybridCpuTestArtifactsRoot=$(HybridCpuTestArtifactsRoot)</HybridCpuIseProjectReferenceProperties>
		<!-- Tests legitimately exercise legacy ICpuState shims (ReadIntRegister / GetInstructionPointer) -->
		<NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\HybridCPU_Compiler.csproj">
			<AdditionalProperties>DefineTestSupport=$(DefineTestSupport)</AdditionalProperties>
		</ProjectReference>
		<ProjectReference Include="..\Compilers\HybridCPU_Platform.Contracts\HybridCPU.Platform.Contracts.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_RuntimeKernel\HybridCPU.RuntimeKernel.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_ManagedRuntime\HybridCPU.ManagedRuntime.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\Native\HybridCPU.Compiler.Native.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\Cil\HybridCPU.Compiler.Cil.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\corpus\ScalarControlFlowV2.Corpus\ScalarControlFlowV2.Corpus.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\OldDocs\RefPlan7\corpus\Phase00.Conformance.Corpus\Phase00.Conformance.Corpus.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\NativeAot\HybridCPU.Compiler.NativeAot.Adapter.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\LLVM\HybridCPU.Compiler.Llvm.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\Oracle\HybridCPU.Compiler.Oracle.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\Compilers\HybridCPU_Compiler\ReleaseQualification\HybridCPU.Compiler.Release.csproj"
						  GlobalPropertiesToRemove="DefineTestSupport;BuildRuntimeDiagnosticConsole;HybridCpuIseProjectReferenceProperties" />
		<ProjectReference Include="..\HybridCPU_ISE\HybridCPU_ISE.csproj">
			<AdditionalProperties>$(HybridCpuIseProjectReferenceProperties)</AdditionalProperties>
		</ProjectReference>
		<ProjectReference Include="..\Compilers\CpuInterfaceBridge\HybridCpu_InterfaceBridge.csproj">
			<AdditionalProperties>DefineTestSupport=$(DefineTestSupport)</AdditionalProperties>
		</ProjectReference>
		<!-- The runtime-owned diagnostic console is migrated at the downstream integration gate.
		 Compiler-focused builds must not pull that outward consumer back into the Core graph. -->
		<ProjectReference Include="..\Diagnostics\TestAssemblerConsoleApps\TestAssemblerConsoleApps.csproj"
						  ReferenceOutputAssembly="false"
						  Condition="'$(BuildRuntimeDiagnosticConsole)' == 'true'" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="obj_r6fresh\**\*.cs" />
		<EmbeddedResource Remove="obj_r6fresh\**\*" />
		<None Remove="obj_r6fresh\**\*" />
