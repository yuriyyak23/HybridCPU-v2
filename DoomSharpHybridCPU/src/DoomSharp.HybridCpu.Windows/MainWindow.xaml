<Window x:Class="DoomSharp.HybridCpu.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DoomSharp · HybridCPU AOT" Width="1120" Height="880" MinWidth="920" MinHeight="700"
 Background="#121820" Foreground="#DFE5EF" FontFamily="Segoe UI" FontSize="14">
 <TabControl Margin="24" Background="#121820" BorderThickness="0">
  <TabItem Header="Запуск">
  <Grid Margin="0">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="DOOMSHARP / HYBRIDCPU" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Нативный AOT guest · Подготовка и проверка запуска" Foreground="#8FA3B9" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <TextBlock Text="Образ" VerticalAlignment="Center"/>
   <TextBox x:Name="ImagePath" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,4,12,4" ToolTip="Настоящий HybridCPU .hcexe"/>
   <Button x:Name="ImageBrowse" Grid.Column="2" Content=".hcexe…" Click="ChooseImage" Margin="0,4,0,4"/>
   <TextBlock Grid.Row="1" Text="Ресурсы" VerticalAlignment="Center"/>
   <TextBox x:Name="WadPath" Grid.Row="1" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,4,12,4"/>
   <Button x:Name="WadBrowse" Grid.Row="1" Grid.Column="2" Content="WAD…" Click="ChooseWad" Margin="0,4,0,4"/>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,0,0,18">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
    <Button x:Name="InspectButton" Content="Проверить запуск" Click="InspectLaunch"/>
    <Button x:Name="CancelButton" Content="Отмена" Click="CancelInspection" IsEnabled="False"/>
    <Button x:Name="RunButton" Content="Запуск ISE" Click="RunGuest" IsEnabled="False"
      ToolTip="Запускает production loader и ISE CPU с ограниченным бюджетом"/>
   </StackPanel>
   <TextBlock x:Name="Status" Text="Запуск заблокирован — loader / ECALL bridge не готов" Foreground="#F2BE72" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
  </DockPanel>
  <Grid Grid.Row="3" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Border Background="#070B10" BorderBrush="#293847" BorderThickness="1" CornerRadius="6" Margin="0,0,18,0">
    <Grid>
     <Image x:Name="GameFrame" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
     <StackPanel x:Name="NoFramePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
     <TextBlock Text="320 × 200" FontSize="36" Foreground="#506174" HorizontalAlignment="Center"/>
     <TextBlock Text="Ожидание нативного framebuffer" Foreground="#8FA3B9" Margin="0,12,0,0" HorizontalAlignment="Center"/>
     <TextBlock Text="CoreCLR Doom не запускается" Foreground="#61758B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="#1B2531" CornerRadius="6" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="КОНТРАКТЫ ЗАПУСКА" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock x:Name="EnvironmentInfo" TextWrapping="Wrap" Foreground="#9DB1C7"/>
      <Separator Margin="0,14"/>
      <TextBlock Text="Требуются до исполнения" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="• Квалифицированный Doom .hcexe&#10;• Managed bootstrap / GC roots&#10;• Loader-backed WAD byte[]&#10;• ISE ECALL → RuntimeKernel&#10;• Clock park/wake, input, video&#10;• EH и managed process exit" TextWrapping="Wrap" Foreground="#D6B681" LineHeight="25"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <TextBox Grid.Row="4" x:Name="Log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
   Background="#0D1219" Foreground="#B9C8DA" BorderBrush="#293847" Padding="12" FontFamily="Consolas" FontSize="12"/>
  <TextBlock Grid.Row="5" Text="Проверка файлов не запускает compiler, guest или CPU. При несовпадении контрактов — отказ без fallback."
   Margin="0,12,0,0" Foreground="#8296AC" FontSize="12" TextWrapping="Wrap"/>
 </Grid>
  </TabItem>
  <TabItem Header="Snapshot">
   <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="SnapshotButton" Content="Получить snapshot" Width="180" Height="34" HorizontalAlignment="Left" Click="CaptureSnapshot"/>
    <TextBox x:Name="SnapshotText" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D1219" Foreground="#B9C8DA" BorderBrush="#293847" Padding="12" FontFamily="Consolas" FontSize="12"/>
   </Grid>
  </TabItem>
 </TabControl>
</Window>
