	<Target Name="RejectReleaseBuildWithInternalTestHooks" BeforeTargets="CoreCompile">
		<Error Condition="'$(Configuration)' == 'Release' and '$(EnableInternalTestHooks)' == 'true'" Text="Release build cannot enable internal test hooks. Build Debug testsupport artifacts instead or disable EnableInternalTestHooks/DefineTestSupport." />
	</Target>

	<Target Name="VerifyVmxProjectionLineage" BeforeTargets="CoreCompile" Condition="'$(EnableVmxProjectionLineageCheck)' == 'true'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\VMXProjectionLineage\VerifyProjectionLineage.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputRoot &quot;$(IntermediateOutputPath)VmxProjectionLineage&quot;" />
	</Target>

