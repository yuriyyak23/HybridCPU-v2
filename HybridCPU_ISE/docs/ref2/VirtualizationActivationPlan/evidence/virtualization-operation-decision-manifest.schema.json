{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybridcpu.local/schemas/virtualization-operation-decision-manifest.v1.json",
  "title": "HybridCPU-v2 virtualization operation owner decision",
  "description": "Schema only. Conformance is governance evidence and never backend, completion, retire or activation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "state",
    "operation_name",
    "decision_owner",
    "owner_source",
    "accepted_commit_sha",
    "required_reviewers",
    "exact_numeric_leaves",
    "value_source",
    "capability_policy",
    "evidence_class",
    "migration_class",
    "denial_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["absent", "draft", "accepted", "withdrawn"] },
    "operation_name": { "type": "string", "minLength": 1 },
    "decision_owner": { "type": "string", "minLength": 1 },
    "owner_source": { "const": "neutral-runtime-owner" },
    "accepted_commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exact_numeric_leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "value_source": { "type": "string", "minLength": 1 },
    "capability_policy": { "type": "string", "minLength": 1 },
    "evidence_class": { "type": "string", "minLength": 1 },
    "migration_class": { "type": "string", "minLength": 1 },
    "denial_reason": { "type": "string", "minLength": 1 }
  }
}
