+        private void CompileHybridCpuMethod(MethodCodeNode methodNode)
+        {
+            MethodDesc method = methodNode.Method;
+            if (!string.Equals(method.Name, _hybridCpuSeam.MethodName, StringComparison.Ordinal) ||
+                method.OwningType is not MetadataType metadataType ||
+                !string.Equals($"{metadataType.Namespace}.{metadataType.Name}", _hybridCpuSeam.TypeName, StringComparison.Ordinal))
+                throw new InvalidOperationException($"HybridCPU seam rejected unexpected dependency-graph method '{method}'.");
+            if (Interlocked.Increment(ref _hybridCpuCompiledMethodCount) != 1)
+                throw new InvalidOperationException("HybridCPU Phase 23 seam supports one dependency-graph method only.");
+
+            string temporaryCode = Path.Combine(Path.GetTempPath(), $"hybridcpu-naot-{Guid.NewGuid():N}.bin");
+            try
+            {
+                var start = new ProcessStartInfo(_hybridCpuSeam.DotNetHost)
+                {
+                    RedirectStandardOutput = true,
+                    RedirectStandardError = true,
+                    UseShellExecute = false,
+                };
+                start.ArgumentList.Add(_hybridCpuSeam.AdapterAssembly);
+                start.ArgumentList.Add("compile");
+                AddPair(start, "--assembly", _hybridCpuSeam.InputAssembly);
+                AddPair(start, "--type", _hybridCpuSeam.TypeName);
+                AddPair(start, "--method", _hybridCpuSeam.MethodName);
+                AddPair(start, "--out", temporaryCode);
+                AddPair(start, "--source-commit", _hybridCpuSeam.SourceCommit);
+                AddPair(start, "--patch-digest", _hybridCpuSeam.PatchDigest);
+                using Process process = Process.Start(start) ?? throw new InvalidOperationException("Unable to start HybridCPU adapter.");
+                var stdoutRead = process.StandardOutput.ReadToEndAsync();
+                var stderrRead = process.StandardError.ReadToEndAsync();
+                process.WaitForExit();
+                string stdout = stdoutRead.GetAwaiter().GetResult();
+                string stderr = stderrRead.GetAwaiter().GetResult();
+                if (process.ExitCode != 0)
+                    throw new InvalidOperationException($"HybridCPU adapter failed with exit {process.ExitCode}: {stderr}{stdout}");
+
+                byte[] code = File.ReadAllBytes(temporaryCode);
+                if (code.Length == 0 || code.Length % 32 != 0)
+                    throw new InvalidOperationException("HybridCPU adapter returned an empty or non-bundle-aligned method body.");
+                _hybridCpuCode = code;
+                methodNode.SetCode(new ObjectNode.ObjectData(code, Array.Empty<Relocation>(), 32, new ISymbolDefinitionNode[] { methodNode }));
+            }
+            finally
+            {
+                if (File.Exists(temporaryCode)) File.Delete(temporaryCode);
+                if (File.Exists(temporaryCode + ".json")) File.Delete(temporaryCode + ".json");
+            }
+        }
+
+        private static void AddPair(ProcessStartInfo start, string name, string value)
+        {
+            start.ArgumentList.Add(name);
+            start.ArgumentList.Add(value);
+        }
+    }
+
+    internal sealed class HybridCpuSeamConfiguration
+    {
+        public string DotNetHost { get; private init; }
+        public string AdapterAssembly { get; private init; }
+        public string InputAssembly { get; private init; }
+        public string TypeName { get; private init; }
+        public string MethodName { get; private init; }
+        public string SourceCommit { get; private init; }
+        public string PatchDigest { get; private init; }
+
+        public static HybridCpuSeamConfiguration Parse(IReadOnlyDictionary<string, string> options)
+        {
+            string[] required = ["HybridCpuDotNetHost", "HybridCpuAdapter", "HybridCpuAssembly", "HybridCpuType", "HybridCpuMethod", "HybridCpuSourceCommit", "HybridCpuPatchDigest"];
+            if (options.Count != required.Length || required.Any(name => !options.TryGetValue(name, out string value) || string.IsNullOrWhiteSpace(value)))
+                throw new InvalidOperationException($"HybridCPU seam requires exactly: {string.Join(", ", required)}.");
+            if (options["HybridCpuSourceCommit"] != "94ea82652cdd4e0f8046b5bd5becbd11461482ca")
+                throw new InvalidOperationException("HCNAOT1001: unsupported dotnet/runtime source commit.");
+            if (options["HybridCpuPatchDigest"].Length != 64 || !options["HybridCpuPatchDigest"].All(Uri.IsHexDigit))
+                throw new InvalidOperationException("HCNAOT1002: patch digest must be 64 hexadecimal characters.");
+
+            return new HybridCpuSeamConfiguration
+            {
+                DotNetHost = options["HybridCpuDotNetHost"],
+                AdapterAssembly = options["HybridCpuAdapter"],
+                InputAssembly = options["HybridCpuAssembly"],
+                TypeName = options["HybridCpuType"],
+                MethodName = options["HybridCpuMethod"],
+                SourceCommit = options["HybridCpuSourceCommit"],
+                PatchDigest = options["HybridCpuPatchDigest"],
+            };
+        }
